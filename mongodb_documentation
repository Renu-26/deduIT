//Category — Read (CRUD)

// Retrieves all documents from the students collection
db.students.find()

// Retrieves students whose department is Computer Science
db.students.find({department: 'Computer Science'})

// Retrieves students who belong to Computer Science AND live in Chennai
db.students.find({department: 'Computer Science', city: 'Chennai'})

// Retrieves Computer Science students and displays only their name and marks
db.students.find({department:"Computer Science"},{name:1, marks: 1})

// Counts all documents in the collection
db.students.find().count()

// Counts documents where the department is Computer Science
db.students.find({department:"Computer Science"}).count()

// Retrieves at most two documents
db.students.find().limit(2)

// Finds students whose age is greater than 20
db.students.find({age: {$gt:20}})

// Finds students older than 20 and counts the matching documents
db.students.find({age: {$gt:20}}.count())

// Finds students whose age is greater than 25
db.students.find({age: {$gt:25}})

// Finds students who have Python OR Java in their skills
db.students.find({$or: [{skills: 'Python'}, {skills: 'Java'}]})


//finds students with Python OR Java and displays only their name and skills (plus _id by default)
db.students.find({$or: [{skills: 'Python'}, {skills: 'Java'}]}, {name:1, skills:1})

// Finds students who live in Chennai OR Pune
db.students.find({city: {$in:['Chennai', 'Pune']}})

// Finds students in Chennai or Pune and displays only name and city
db.students.find({city: {$in:['Chennai', 'Pune']}}, {name:1, city:1})

// Finds students whose city is neither Chennai nor Pune
db.students.find({city: {$nin:['Chennai', 'Pune']}}, {name:1, city:1})

// category — Update (CRUD)


// Finds one student by ObjectId and updates their city to Chennai
db.students.updateOne({_id: ObjectId('6ad95ffea1c3856ddafe5cff')}, {$set: {city: "Chennai"}})

// Finds one student by ObjectId and changes their department to Electronics

db.students.updateOne(
    { _id: ObjectId("6ad96205a1c3856ddafe5d01") },
    { $set: { department: "Electronics" } })

// Updates every student in the Electronics department

db.student.updateMany({department: "Electronics"}, {$set: {department: "Electronics and Communication"}})

//category- Delete (CRUD)

// Deletes one student document matching the given ObjectId
db.students.deleteOne({_id: ObjectId('6ad9276b658914278191351c')})

// Deletes all student documents whose marks are below 90
db.students.deleteMany({marks: {$lt:90}})
